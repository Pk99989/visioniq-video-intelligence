# Copy to .env and fill in. Never commit a real .env.
JWT_SECRET=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./backend/visioniq.db
# For docker-compose.yml (full stack): postgresql://visioniq:visioniq@postgres:5432/visioniq
STORAGE_DIR=./backend/storage
MAX_UPLOAD_MB=500
ALLOWED_EXTENSIONS=mp4,mov,webm,mkv,avi
FRAME_FPS=1
MAX_FRAMES=120
SCENE_THRESHOLD=30.0
EMBEDDING_DIM=384
# vlm: fallback | openai_compatible | nvidia_nim | ollama
# Ollama on the laptop (RTX 3050): install Ollama, run
#   ollama pull llava:7b   (or qwen2-vl:7b)
# then set VLM_PROVIDER=ollama, VLM_BASE_URL=http://localhost:11434/v1,
# VLM_MODEL=llava:7b. For the full docker stack, use
# VLM_BASE_URL=http://host.docker.internal:11434/v1 instead.
# CPU-only machines: use a small model instead, e.g. moondream
#   ollama pull moondream
# llava:7b needs ~5 GB RAM/VRAM; moondream needs ~2 GB RAM.
VLM_PROVIDER=fallback
VLM_MODEL=
VLM_BASE_URL=
VLM_API_KEY=
# VLM reliability (Phase 1, v0.4.0): per-attempt timeout, retries with
# exponential backoff, health-probe timeout. Captions record their
# provider: the VLM name on real model output, 'detection' when only
# YOLO labels were available, 'fallback' for timing-only templates.
VLM_TIMEOUT_SECONDS=120
VLM_MAX_RETRIES=2
VLM_RETRY_BACKOFF_SECONDS=2.0
VLM_HEALTH_TIMEOUT_SECONDS=10
# Embeddings: hash (default, no download) | fastembed (Phase 2, real
# semantic embeddings, ~65 MB model download on first use) |
# sentence_transformers (needs torch)
EMBEDDING_PROVIDER=hash
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
QDRANT_URL=
QDRANT_COLLECTION=visioniq_frames
# Cross-encoder reranker for search (Phase 4). Empty = off (hybrid
# score only). Set to "Xenova/ms-marco-MiniLM-L-6-v2" to rerank the
# top candidates (~80 MB model download on first use).
RERANKER_MODEL=
# Detection: put yolov8n.onnx in backend/ (python scripts/download_yolo.py)
# or set YOLO_MODEL_PATH to its location. No weights = no detections.
YOLO_MODEL_PATH=
# Detection calibration (Phase 3): default confidence, NMS IoU, class
# allow-list (empty = all COCO classes), per-class confidence
# overrides, track matching IoU, missed-frame budget and max track age.
YOLO_CONF=0.35
YOLO_NMS=0.45
YOLO_CLASSES=
YOLO_CLASS_CONF=
YOLO_MIN_TRACK_IOU=0.3
YOLO_TRACK_MAX_MISSED=5
YOLO_TRACK_MAX_AGE_SECONDS=120
# Execution providers tried in order; CUDA first when a GPU exists,
# CPU is the fallback. On a CPU-only machine this stays CPU.
YOLO_EXECUTION_PROVIDERS=CUDA,CPU
# Zone event engine (Phase 6): a track inside a zone continuously
# for EVENT_DWELL_SECONDS fires a dwell event; EVENT_LOITER_SECONDS
# fires a "possible loitering" candidate (needs VLM verification).
# Evidence clips span [event - PRE, event + POST] seconds.
EVENT_DWELL_SECONDS=5
EVENT_LOITER_SECONDS=30
EVENT_CLIP_PRE_SECONDS=2
EVENT_CLIP_POST_SECONDS=3
# Worker: in_process (laptop, default) | celery (full stack, needs Redis)
WORKER_MODE=in_process
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
